<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL shortner Project</title>
</head>
<body>
    <div class="container">
        <h1>URL shortner Project</h1>
        <form action="/short" method="POST">
            <label for="longUrl">Enter long URL:</label> 
            <input type="text" id="longUrl" name="longUrl" required>
            <button type="submit">Shortnen</button>
        </form>
        <% if(shortUrl) { %>
        <p> Short URL :- <a href="<%=shortUrl%>" target="_blank"/>
        <%= shortUrl %>
        </p> <% } %>
    </div>
</body>
</html>